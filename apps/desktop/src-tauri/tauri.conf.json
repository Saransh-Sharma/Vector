{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vector",
  "version": "0.1.0",
  "identifier": "dev.vector.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Vector", "width": 1440, "height": 920, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "targets": "all", "category": "DeveloperTool", "shortDescription": "Local harness control plane" }
}
